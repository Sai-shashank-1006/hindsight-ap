# Copy to .env and fill in. Never commit .env: it holds your keys.
GROQ_API_KEY=your_groq_key
# Hindsight Cloud: its URL and your key. Or run Hindsight locally (python -m scripts.local_hindsight):
# HINDSIGHT_API_URL=http://127.0.0.1:8888 and leave HINDSIGHT_API_KEY empty.
HINDSIGHT_API_KEY=your_hindsight_key
HINDSIGHT_BANK_ID=your_bank_id
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io

# Which data to serve: demo (the 4-invoice story), real (1,623 USAID SCMS lines) or synthetic (482 invoices)
# DATASET=demo

# MySQL (optional): stores vendors, POs, invoices and the decision log. Fill in the user and password
# to turn it on; the database is created and the dataset imported on the API's first start.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=paysage

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# DATA_DIR=data
# DECISION_LOG_PATH=decision_log.jsonl
